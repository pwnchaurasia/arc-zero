# Copy to .env for local development. Never commit real secrets.
ARC_ENV=development
ARC_DATABASE_URL=postgresql+asyncpg://arc:arc@localhost:55432/arc
ARC_REDIS_URL=redis://localhost:56379/0
ARC_LEVELS_PATH=levels.json
# Generate each with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ARC_SIGNING_KEYS={"k1": "replace-with-a-long-random-secret-of-48-chars-or-more"}
ARC_SIGNING_KID=k1
ARC_RECOVERY_PEPPER=replace-with-another-long-random-secret-48-chars
ARC_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:4173"]
ARC_ALLOWED_HOSTS=["localhost","127.0.0.1"]
ARC_EXPOSE_DOCS=true
