# Copy to infra/secrets/api.env and fill in. Never commit the real file.
ARC_ENV=production
ARC_DATABASE_URL=postgresql+asyncpg://arc:<postgres_password>@postgres:5432/arc
ARC_REDIS_URL=redis://:<redis_password>@redis:6379/0
# python3 -c "import secrets; print(secrets.token_urlsafe(48))" for each secret below
ARC_SIGNING_KEYS={"k1": "<secret>"}
ARC_SIGNING_KID=k1
ARC_RECOVERY_PEPPER=<secret>
ARC_ALLOWED_ORIGINS=["https://play.example.com"]
# 127.0.0.1 is for the container healthcheck (only reachable inside the container).
ARC_ALLOWED_HOSTS=["play.example.com","127.0.0.1"]
ARC_COOKIE_SECURE=true
ARC_HSTS=true
ARC_EXPOSE_DOCS=false
